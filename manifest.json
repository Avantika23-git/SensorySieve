{
  "manifest_version": 3,
  "name": "SensorySieve",
  "version": "1.0",
  "description": "One accessibility layer across the whole web — Parkinson's, Focus, and Dyslexia modes.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-scripts/dyslexia/dyslexia.js"],
      "css": ["content-scripts/dyslexia/dyslexia.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/fonts/OpenDyslexic-Regular.otf"],
      "matches": ["<all_urls>"]
    }
  ]
}